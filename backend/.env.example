# Pick one provider for the agent's tool-calling loop: anthropic | openai | google
LLM_PROVIDER=google

# Free tier, no credit card - https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

# For the final build, switch LLM_PROVIDER to one of these instead:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Razorpay TEST MODE keys (https://dashboard.razorpay.com/app/keys -> Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=4000

# Redis holds chat session history and in-flight order drafts (the gate/
# confirmation working state). The durable audit trail stays in SQLite
# regardless - Redis never holds the audit record itself.
REDIS_URL=redis://localhost:6379
